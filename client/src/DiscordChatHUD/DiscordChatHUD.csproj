<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>DiscordChatHUD</AssemblyName>
    <AssemblyTitle Condition="'$(AssemblyTitle)' == ''">DiscordChatHUD · HUD</AssemblyTitle>
    <RelayOnly Condition="'$(RelayOnly)' == ''">true</RelayOnly>
    <RootNamespace>DiscordChatHUD</RootNamespace>
    <Version>1.0.334</Version>
    <FileVersion>1.0.334.0</FileVersion>
    <Product>DiscordChatHUD C# Public Source 334</Product>
    <ApplicationIcon>Assets\gtao_hud_icon.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup Condition="'$(ClientRole)' != 'Watcher' And Exists('Assets\Watcher.exe.gz')">
    <EmbeddedResource Include="Assets\Watcher.exe.gz" LogicalName="DiscordChatHUD.Watcher.exe.gz" />
  </ItemGroup>

  <PropertyGroup Condition="'$(RelayOnly)' == 'true'">
    <DefineConstants>$(DefineConstants);RELAY_CLIENT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BetaRelease)' == 'true'">
    <DefineConstants>$(DefineConstants);BETA_RELEASE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LZ4_LICENSE.txt">
      <TargetPath>Data\LZ4_LICENSE.txt</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Assets\NotoSansKR-Medium.otf">
      <TargetPath>Data\NotoSansKR-Medium.otf</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Assets\NotoSansKR-Medium.ttf">
      <TargetPath>Data\NotoSansKR-Medium.ttf</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <Content Include="Assets\gtao_hud_icon.ico">
      <TargetPath>Data\gtao_hud_icon.ico</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <None Update="Assets\radar_hangar.png">
      <TargetPath>Data\radar_hangar.png</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Assets\radar_warehouse.png">
      <TargetPath>Data\radar_warehouse.png</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Assets\radar_property_bunker.png">
      <TargetPath>Data\radar_property_bunker.png</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Assets\radar_acid_lab.png">
      <TargetPath>Data\radar_acid_lab.png</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Assets\config.json">
      <TargetPath>Data\settings.json</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\..\FONT_LICENSE_OFL.txt">
      <Link>FONT_LICENSE_OFL.txt</Link>
      <TargetPath>Data\FONT_LICENSE_OFL.txt</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\..\ASSET_LICENSE.txt">
      <Link>ASSET_LICENSE.txt</Link>
      <TargetPath>Data\ASSET_LICENSE.txt</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/BusinessIcons/*.png" LogicalName="BusinessHudIcons.%(Filename).png" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Services/NightclubOcr.ps1" LogicalName="NightclubOcr.ps1" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Services/UpdatePublicKey.xml" LogicalName="UpdatePublicKey.xml" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Services/DefaultSettings.json" LogicalName="DefaultSettings.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Services/ReleaseNotes.json" LogicalName="ReleaseNotes.json" /></ItemGroup>
</Project>




